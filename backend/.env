# EventFlow Backend Environment Variables

# Application
APP_NAME=EventFlow
APP_VERSION=1.0.0
APP_DESCRIPTION=Complete Event Volunteer Management System
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]'
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS='["*"]'
CORS_ALLOW_HEADERS='["*"]'

# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=eventflow
MAX_CONNECTIONS=100
MIN_CONNECTIONS=10

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@eventflow.app
SMTP_FROM_NAME=EventFlow
SMTP_TLS=True
SMTP_SSL=False

# Frontend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# WebSocket
WEBSOCKET_URL=ws://localhost:8000
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_PING_INTERVAL=30

# File Upload
UPLOAD_DIR=static/uploads
MAX_FILE_SIZE_MB=10

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=100
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBER=True
PASSWORD_REQUIRE_SPECIAL=True

# Rate Limiting
RATE_LIMIT=100
RATE_LIMIT_AUTH=1000

# Session
SESSION_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
CSRF_ENABLED=False
HSTS_ENABLED=False

# Cache
CACHE_ENABLED=False
CACHE_TTL=300
