# EventFlow Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000

# App Configuration
VITE_APP_NAME=EventFlow
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Complete Event Volunteer Management System

# Feature Flags
VITE_DEBUG=True
VITE_ENABLE_ANALYTICS=False
VITE_ENABLE_LOGGING=True

# Theme
VITE_DEFAULT_THEME=SYSTEM

# API Timeouts
VITE_API_TIMEOUT=30000
VITE_WS_RECONNECT_DELAY=3000
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# Pagination
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Animation
VITE_ENABLE_ANIMATIONS=True
VITE_REDUCED_MOTION=False

# Notifications
VITE_NOTIFICATION_DURATION=5000
VITE_NOTIFICATION_MAX=10

# Cache
VITE_ENABLE_CACHE=True
VITE_CACHE_TTL=300000
